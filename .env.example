# Copy to .env and fill in your keys. .env is gitignored — never commit it.
NVIDIA_API_KEY=
GROQ_API_KEY=
# Receiver: set VAIA_TOKEN to require this shared token on every /api/* and
# /shots/* request (the dashboard will prompt for it; put the same value in
# Options → Database → API key so the extension can send it).
# VAIA_TOKEN=
# VAIA_DATA_DIR=/var/lib/vaia   # move SQLite + screenshots out of the repo
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
