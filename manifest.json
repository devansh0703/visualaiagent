{
  "manifest_version": 3,
  "name": "Visual AI Agent — Screen Intelligence",
  "version": "0.1.0",
  "description": "Monitors the browser screen and all user activity, analyzes it with a vision AI model, and streams structured telemetry to your database.",
  "minimum_chrome_version": "116",
  "default_locale": "en",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "alarms",
    "notifications",
    "downloads",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup/popup.html",
    "default_title": "Visual AI Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "ui/options/options.html",
  "commands": {
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume monitoring"
    },
    "capture-now": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Capture and analyze the current screen"
    },
    "open-dashboard": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Open the VAIA dashboard"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["content/element-tools.js", "content/privacy-scan.js", "content/content.js"],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
