{
  "name": "visual-ai-agent",
  "version": "1.0.0",
  "description": "A Visual AI Agent Chrome extension: monitors the browser screen and user activity, analyzes it with vision LLMs, and streams telemetry to your database.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-test-module-mocks --test \"test/unit/*.test.mjs\"",
    "test:integration": "node --test \"test/integration/*.test.mjs\"",
    "e2e": "node test/e2e/run.mjs",
    "server": "node server/server.mjs",
    "demo:capture": "node scripts/capture-demo.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0"
  }
}
